---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraWhatsApp from '../components/BarraWhatsApp.astro';
import DatosNegocio from '../components/DatosNegocio.astro';
import { negocio } from '../data/negocio';
// Imagen para compartir (1200 × 630): la plantilla vive en assets/compartir/ del espacio de trabajo.
import imagenCompartir from '../assets/marca/compartir.jpg';

interface Props {
  /** Título de la página; se le agrega el nombre del negocio, salvo que ya empiece con él. */
  titulo: string;
  /** Descripción para Google y para cuando se comparte el enlace. */
  descripcion: string;
  /** Mensaje de WhatsApp de esta página; si falta, se usa el general. */
  mensajeWhatsApp?: string;
  /** false para páginas internas que no deben aparecer en Google. */
  indexar?: boolean;
}

const { titulo, descripcion, mensajeWhatsApp, indexar = true } = Astro.props;

const tituloCompleto = titulo.startsWith(negocio.nombre) ? titulo : `${titulo} | ${negocio.nombre}`;

// Al compilar, Astro.url.pathname trae barra al final (/contacto/); las direcciones públicas van sin ella.
// Las páginas sin indexar no llevan canónica: la 404 se muestra en cualquier dirección que no exista.
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonica = Astro.site && indexar ? new URL(ruta, Astro.site).href : undefined;

// Facebook y WhatsApp piden la dirección completa de la imagen.
const compartir = await getImage({ src: imagenCompartir, width: 1200, height: 630, format: 'jpg', quality: 82 });
const urlCompartir = Astro.site ? new URL(compartir.src, Astro.site).href : undefined;
const altCompartir = `Logo de ${negocio.nombre}, el título ¿Tu aparato dejó de funcionar?, el WhatsApp ${negocio.telefono} con la frase Mándanos foto y te cotizamos, y una fila de aparatos (pantalla, bocina, microondas, licuadora, ventilador y plancha) con el sello de ${negocio.experiencia}.`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    {/* La fuente va arriba para que el navegador encuentre la precarga cuanto antes */}
    <Font cssVariable="--font-montserrat" preload={[{ weight: '400' }, { weight: '700' }]} />
    <meta name="description" content={descripcion} />
    {!indexar && <meta name="robots" content="noindex, nofollow" />}
    {canonica && <link rel="canonical" href={canonica} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2a44" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    {
      urlCompartir && (
        <>
          <meta property="og:image" content={urlCompartir} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={altCompartir} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {indexar && <link rel="sitemap" href="/sitemap-index.xml" />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header mensajeWhatsApp={mensajeWhatsApp} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <BarraWhatsApp mensaje={mensajeWhatsApp} />
    {/* Datos para Google al final: no retrasan el primer render */}
    {indexar && <DatosNegocio imagen={urlCompartir} />}
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    top: var(--esp-2);
    left: var(--esp-2);
    z-index: 20;
    padding: var(--esp-3) var(--esp-4);
    background: var(--color-acento);
    color: var(--color-fondo);
    font-weight: var(--peso-negrita);
    border-radius: var(--radio-boton);
    transform: translateY(-200%);
  }

  .saltar:focus {
    transform: none;
  }
</style>
